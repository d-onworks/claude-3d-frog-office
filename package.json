{
  "name": "claude-3d-frog-office",
  "version": "0.1.0",
  "description": "A view-only 3D office that shows each Claude Code session as a frog or capybara character. Local only, zero dependencies, macOS and Windows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-onworks/claude-3d-frog-office.git"
  },
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "ai-agents",
    "dashboard",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "demo": "node scripts/start.mjs --demo --open",
    "test": "node --test"
  }
}
